# Server
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
# Set when deployed behind a reverse proxy/load balancer so express-rate-limit
# sees the real client IP instead of the proxy's (e.g. "1" for one hop).
# Leave unset for local dev / no proxy.
TRUST_PROXY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking

# Redis (OTP storage + BullMQ queue)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_ADMIN_EXPIRES_IN=8h
JWT_VERIFICATION_EXPIRES_IN=10m

# Admin seed (used only by prisma/seed.js to create/update the admin login)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# AdminJS backoffice UI session (separate secret from JWT_SECRET)
ADMIN_SESSION_SECRET=change_this_to_another_long_random_string

# Twilio (SMS OTP + notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (SMTP - works with Resend/SendGrid/Postmark SMTP relay too)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Makeup Studio <no-reply@yourdomain.com>"

# Cloudinary (staff/service images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
